<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_est_inventory_doctor_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">est_inventory_doctor_dashboard</field>
    </record>

    <menuitem id="menu_est_inventory_doctor_root"
              name="Inventory Doctor"
              sequence="45"
              groups="stock.group_stock_manager"/>

    <menuitem id="menu_est_inventory_doctor_dashboard"
              name="Dashboard"
              parent="menu_est_inventory_doctor_root"
              action="action_est_inventory_doctor_dashboard"
              sequence="1"/>

    <menuitem id="menu_est_inventory_doctor_new_scan"
              name="Run New Scan"
              parent="menu_est_inventory_doctor_root"
              action="action_est_inventory_doctor_new_scan"
              sequence="2"/>

    <menuitem id="menu_est_inventory_doctor_scans"
              name="Scan History"
              parent="menu_est_inventory_doctor_root"
              action="action_est_inventory_doctor_scan"
              sequence="3"/>

</odoo>
