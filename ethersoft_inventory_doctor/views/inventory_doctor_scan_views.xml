<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_est_inventory_doctor_scan_list" model="ir.ui.view">
        <field name="name">est.inventory.doctor.scan.tree</field>
        <field name="model">est.inventory.doctor.scan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="scan_date"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="health_score"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'running'"
                       decoration-danger="state == 'error'"/>
                <field name="critical_count"/>
                <field name="warning_count"/>
                <field name="open_count"/>
                <field name="fixable_count"/>
                <field name="duration_seconds" optional="hide"/>
                <field name="odoo_version" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_est_inventory_doctor_scan_form" model="ir.ui.view">
        <field name="name">est.inventory.doctor.scan.form</field>
        <field name="model">est.inventory.doctor.scan</field>
        <field name="arch" type="xml">
            <form string="Inventory Health Scan">
                <header>
                    <button name="action_run_scan" type="object"
                            string="Run Scan" class="btn-primary"
                            invisible="state == 'running'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                    <field name="issue_count" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Inventory Health Scan"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scan_date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="odoo_version"/>
                            <field name="duration_seconds"/>
                        </group>
                        <group>
                            <field name="health_score"/>
                            <field name="health_score_label"/>
                            <field name="open_count"/>
                            <field name="fixed_count"/>
                            <field name="warning_count"/>
                            <field name="info_count"/>
                        </group>
                    </group>

                    <div class="alert alert-info mb-3" role="alert" name="est_pro_upsell"
                         invisible="state != 'done'">
                        <strong>Detailed diagnosis, Safe Auto-Fix, Fix Audit Log, and PDF reports</strong>
                        are available in EtherSoft Inventory Doctor PRO.
                    </div>

                    <div class="o_est_issue_why" invisible="state != 'done'">
                        <separator string="How Is My Score Calculated?"/>
                        <field name="health_score_explanation_html" nolabel="1" class="w-100"/>
                    </div>

                    <div invisible="state != 'done' or issue_count == 0"
                         class="alert alert-warning mb-3" role="alert">
                        <h4 class="alert-heading">Scan Results</h4>
                        <field name="summary_html" nolabel="1"/>
                    </div>
                    <div invisible="state != 'done' or issue_count != 0"
                         class="alert alert-success mb-3" role="alert">
                        <strong>No issues detected.</strong> Your inventory valuation looks healthy.
                    </div>
                    <div invisible="state != 'error'"
                         class="alert alert-danger mb-3" role="alert">
                        <strong>Scan failed:</strong>
                        <field name="error_message" nolabel="1"/>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_est_inventory_doctor_scan_kanban" model="ir.ui.view">
        <field name="name">est.inventory.doctor.scan.kanban</field>
        <field name="model">est.inventory.doctor.scan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard o_est_scan_kanban" default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="scan_date"/>
                <field name="user_id"/>
                <field name="health_score"/>
                <field name="issue_count"/>
                <field name="critical_count"/>
                <field name="warning_count"/>
                <field name="open_count"/>
                <field name="fixable_count"/>
                <field name="fixed_count"/>
                <field name="summary_html"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_est_scan_card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'done': 'success', 'running': 'warning', 'error': 'danger', 'draft': 'default'}}"/>
                            </div>
                            <div class="text-muted mb-2">
                                <field name="scan_date"/> · Score <field name="health_score"/>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge text-bg-danger"><field name="critical_count"/> critical</span>
                                <span class="badge text-bg-warning"><field name="warning_count"/> warn</span>
                                <span class="badge text-bg-secondary"><field name="open_count"/> open</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_est_inventory_doctor_scan" model="ir.actions.act_window">
        <field name="name">Scan History</field>
        <field name="res_model">est.inventory.doctor.scan</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="action_est_inventory_doctor_new_scan" model="ir.actions.server">
        <field name="name">Run New Scan</field>
        <field name="model_id" ref="model_est_inventory_doctor_scan"/>
        <field name="state">code</field>
        <field name="code">action = model.action_new_scan()</field>
    </record>

</odoo>
